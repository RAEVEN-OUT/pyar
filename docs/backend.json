
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile within the Amorem Duo application.",
      "properties": {
        "role": {
          "type": "string",
          "description": "The user's role within the app ('Him' or 'Her').",
          "enum": ["Raveen", "Priya"]
        },
        "mood": {
          "type": "object",
          "properties": {
              "mood": {"type": "string"},
              "emoji": {"type": "string"}
          }
        }
      },
      "required": [
        "role"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "description": "Represents a single message within the private chat.",
      "properties": {
        "senderId": {
          "type": "string",
          "description": "The Firebase UID of the message sender."
        },
        "sender": {
          "type": "string",
          "enum": ["Raveen", "Priya"]
        },
        "text": {
          "type": "string",
          "description": "The text content of the message."
        },
        "audioUrl": {
            "type": "string",
            "format": "uri"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "reactions": {
            "type": "object"
        },
        "isEdited": {
            "type": "boolean"
        },
        "replyTo": {
            "type": "object"
        }
      },
      "required": [
        "senderId",
        "sender",
        "timestamp"
      ]
    },
    "Note": {
      "title": "Note",
      "type": "object",
      "description": "Represents a note created by a user for a specific date.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the note (yyyy-MM-dd)."
        },
        "author": {
          "type": "string",
          "enum": ["Raveen", "Priya"]
        },
        "text": {
          "type": "string"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "author",
        "text",
        "lastUpdated"
      ]
    },
    "ImportantDate": {
      "title": "ImportantDate",
      "type": "object",
      "description": "Represents an important date or event.",
      "properties": {
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "authorId": {
            "type": "string"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        }
      },
      "required": [
        "date",
        "title",
        "authorId",
        "createdAt"
      ]
    },
    "Sticker": {
        "title": "Sticker",
        "type": "object",
        "properties": {
            "id": {"type": "string"},
            "emoji": {"type": "string"}
        },
        "required": ["id", "emoji"]
    },
    "ToDoTask": {
      "title": "ToDoTask",
      "type": "object",
      "description": "Represents a task in the shared to-do list.",
      "properties": {
        "text": { "type": "string" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "assignee": { "type": "string", "enum": ["Raveen", "Priya"] },
        "creator": { "type": "string", "enum": ["Raveen", "Priya"] },
        "createdAt": { "type": "string", "format": "date-time"}
      },
      "required": [
        "text",
        "assignee",
        "creator",
        "createdAt"
      ]
    },
    "Photo": {
      "title": "Photo",
      "type": "object",
      "description": "Represents a photo in the albums.",
      "properties": {
        "url": { "type": "string", "format": "uri"},
        "storagePath": { "type": "string" },
        "description": { "type": "string" },
        "uploader": { "type": "string" },
        "isPrivate": {"type": "boolean"},
        "createdAt": {"type": "string", "format": "date-time"}
      },
      "required": [
        "url",
        "storagePath",
        "description",
        "uploader",
        "isPrivate",
        "createdAt"
      ]
    },
    "DisciplineActivity": {
        "title": "DisciplineActivity",
        "type": "object",
        "properties": {
            "label": {"type": "string"},
            "checks": {"type": "object"},
            "creatorId": {"type": "string"}
        },
        "required": ["label", "creatorId"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profile data."
    },
    "/privateChats/mainChat/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Stores all chat messages."
    },
    "/userProfiles/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note"},
      "description": "Notes for a specific user."
    },
    "/importantDates/{dateId}": {
        "schema": {"$ref": "#/entities/ImportantDate"},
        "description": "Shared calendar events."
    },
    "/stickers/{stickerId}": {
        "schema": {"$ref": "#/entities/Sticker"},
        "description": "Emoji stickers for calendar dates."
    },
    "/toDoTasks/{taskId}": {
        "schema": {"$ref": "#/entities/ToDoTask"},
        "description": "Shared to-do list tasks."
    },
    "/photos/{photoId}": {
        "schema": {"$ref": "#/entities/Photo"},
        "description": "Shared and private photos."
    },
    "/disciplineActivities/{activityId}": {
        "schema": {"$ref": "#/entities/DisciplineActivity"},
        "description": "Discipline tracker activities."
    }
  }
}
