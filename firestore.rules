rules_version = '2';

/**
 * @fileoverview Firestore Security Rules for the Amorem Duo application.
 *
 * @description
 * This ruleset is designed for a private application intended for two specific users ("Him" and "Her").
 * It enforces a security model that blends strict user ownership for personal data with shared access
 * for collaborative features. All operations require user authentication.
 *
 * Core Philosophy:
 * The security model is built on the principle of "default deny". Access is only granted
 * through explicit `allow` statements. Every action, from reading a chat message to creating
 * a to-do task, requires a user to be signed in.
 *
 * Data Structure:
 * The data is organized into a mix of user-private and shared top-level collections:
 * - /users/{userId}: Private user profiles. A user can only access their own document.
 * - /users/{userId}/notes: Private notes. All notes are nested under the user who created them.
 * - /chats, /important_dates, /todo_tasks, /photos: Top-level collections for shared data.
 *   Access is controlled by fields within each document (e.g., `creatorId`, `uploaderId`, `assigneeId`).
 *
 * Key Security Decisions:
 * - Authentication Required: No unauthenticated access is permitted anywhere in the database.
 * - No User Listing: To protect user privacy, it is not possible to list all documents in the `/users` collection.
 * - Denormalization for Security: Authorization data (like `creatorId` or `uploaderId`) is denormalized
 *   (copied) onto each document. This avoids slow and costly `get()` calls in rules, leading to better
 *   performance and simpler, more secure logic. For example, a rule on `/photos/{photoId}` can check
 *   the `uploaderId` field directly without needing to look up another document.
 * - Shared Access Model: Since the app is for a couple, any data in top-level shared collections
 *   (like chats, todos, important dates, and non-private photos) is readable by either authenticated user.
 *   Write permissions, however, are strictly controlled by ownership fields.
 * - Photo Privacy: The `/photos` collection uses an `isPrivate` flag. The rules ensure that a document
 *   marked as private can only be read by its uploader. Client-side queries must be constructed carefully
 *   to avoid permission errors when listing photos (e.g., by querying for public photos or the user's own photos).
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the authenticated user's UID matches the provided userId.
     * Used to verify resource ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Returns true if the user is the owner of an existing document.
     * Protects update/delete operations from acting on non-existent data.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates that a user can read a photo. A user can read a photo if
     * it is not private (`isPrivate == false`) or if they are the uploader.
     */
    function canReadPhoto(photoData) {
      return isSignedIn() && (photoData.isPrivate == false || photoData.uploaderId == request.auth.uid);
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (get) A user `abc` can get their own profile at `/users/abc`.
     * @deny  (get) A user `xyz` cannot get user `abc`'s profile.
     * @deny  (list) No user can list all documents in the `/users` collection.
     * @principle Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if false;
    }

    /**
     * @description Controls access to messages in the shared chat.
     * @path /chats/{chatId}/messages/{messageId}
     * @allow (create) Any signed-in user can create a message.
     * @allow (list) Any signed-in user can list all messages in the chat.
     * @deny  (create) An unauthenticated user cannot create a message.
     * @principle Enforces shared access for a closed group (the couple). Validates author identity on create.
     */
    match /chats/{chatId}/messages/{messageId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to a user's private notes.
     * @path /users/{userId}/notes/{noteId}
     * @allow (create) User `abc` can create a new note in their own `/users/abc/notes` collection.
     * @allow (list) User `abc` can list all notes in their `/users/abc/notes` collection.
     * @deny  (get) User `xyz` cannot read a note from `/users/abc/notes/{noteId}`.
     * @principle Enforces strict data ownership using path-based security.
     */
    match /users/{userId}/notes/{noteId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.authorId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to shared important dates.
     * @path /important_dates/{dateId}
     * @allow (list) Any signed-in user can list all important dates.
     * @allow (update) The user who created a date can update it.
     * @deny  (update) A user cannot update a date they did not create.
     * @principle Implements a "public read, owner-only write" model for the couple.
     */
    match /important_dates/{dateId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.creatorId) && request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if isExistingOwner(resource.data.creatorId);
    }

    /**
     * @description Controls access to the shared to-do list.
     * @path /todo_tasks/{taskId}
     * @allow (list) Any signed-in user can list all tasks.
     * @allow (update) The user assigned to a task can update it (e.g., mark as complete).
     * @deny  (update) A user cannot update a task that is assigned to their partner.
     * @principle Enforces shared read access but restricts modification rights to the assignee.
     */
    match /todo_tasks/{taskId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isExistingOwner(resource.data.assigneeId);
      allow delete: if isExistingOwner(resource.data.assigneeId);
    }

    /**
     * @description Controls access to shared and private photos.
     * @path /photos/{photoId}
     * @allow (get) A user can get any public photo (`isPrivate == false`).
     * @allow (get) A user can get their own private photo (`isPrivate == true`).
     * @deny  (get) A user cannot get their partner's private photo.
     * @principle Handles mixed privacy levels. Read access depends on document content (`isPrivate` flag).
     * @warning (list) Listing is allowed for any authenticated user, but client queries MUST be
     *          constructed to request only public photos (`where('isPrivate', '==', false)`) or the user's
     *          own photos (`where('uploaderId', '==', auth.uid)`) to avoid permission errors.
     */
    match /photos/{photoId} {
      allow get: if canReadPhoto(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.uploaderId) && request.resource.data.uploaderId == resource.data.uploaderId;
      allow delete: if isExistingOwner(resource.data.uploaderId);
    }
  }
}